# Anthropic API 키 (필수)
ANTHROPIC_API_KEY=sk-ant-...

# 수집 단말 인증 토큰 (필수) — 안드로이드 수집기와 공유하는 비밀값
INGEST_TOKEN=change-me-to-a-long-random-string

# DB (기본: 로컬 SQLite). 운영시 Postgres 권장: postgresql+psycopg://user:pw@host/db
DATABASE_URL=sqlite:///./selfdeploy.db

# 분류/답변 모델
# 실시간 고볼륨 분류는 비용상 claude-haiku-4-5 로 바꿀 수 있습니다.
CLASSIFIER_MODEL=claude-opus-4-8
ANSWER_MODEL=claude-opus-4-8

# 긴급으로 간주할 이슈 레벨 (콤마구분): urgent,incident
ALERT_LEVELS=urgent,incident
